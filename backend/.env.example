### Backend environment example for OTP email (rename to .env and fill values)
# SMTP settings (Gmail example - use App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=replace_with_app_password_here
FROM_EMAIL="Amadeo Coffee <your@gmail.com>"

# OTP settings (optional)
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN=30
OTP_MAX_REQUESTS_PER_HOUR=10

# Supabase (optional) - fill if you use Supabase storage/API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
