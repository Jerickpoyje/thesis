powershell -ExecutionPolicy Bypass -Command "Remove-Item .git\index.lock -Force -ErrorAction SilentlyContinue; try { git rm -r --cached .vite -f -q } catch { }; Remove-Item -Recurse -Force .vite -ErrorAction SilentlyContinue; if(-not (Test-Path .gitignore)) { '' | Out-File -FilePath .gitignore -Encoding utf8 }; if(-not (Select-String -Path .gitignore -Pattern '^\\.vite/' -Quiet)) { '.vite/' | Out-File -FilePath .gitignore -Encoding utf8 -Append }; if(-not (Select-String -Path .gitignore -Pattern '^node_modules/' -Quiet)) { 'node_modules/' | Out-File -FilePath .gitignore -Encoding utf8 -Append }; if(-not (Select-String -Path .gitignore -Pattern '^dist/' -Quiet)) { 'dist/' | Out-File -FilePath .gitignore -Encoding utf8 -Append }; git add .gitignore; git add -A; $s=(git status --porcelain); Write-Host $s; if($s -ne '') { git commit -m 'Remove committed build artifacts (.vite) and ignore them' ; git push } else { Write-Host 'No changes to commit' }"
powershell -ExecutionPolicy Bypass -Command "Remove-Item .git\index.lock -Force -ErrorAction SilentlyContinue; git rm -r --cached .vite -f -q 2>$null; Remove-Item -Recurse -Force .vite -ErrorAction SilentlyContinue; if(-not (Test-Path .gitignore)) { '' | Out-File -FilePath .gitignore -Encoding utf8 }; $gitignore = Get-Content .gitignore -Raw; if($gitignore -notmatch '(^|\r?\n)\.vite/') { Add-Content .gitignore '\n.vite/' }; if($gitignore -notmatch '(^|\r?\n)node_modules/') { Add-Content .gitignore '\nnode_modules/' }; if($gitignore -notmatch '(^|\r?\n)dist/') { Add-Content .gitignore '\ndist/' }; git add .gitignore; git add -A; $s = git status --porcelain; Write-Host $s; if($s -ne '') { git commit -m 'Remove committed build artifacts (.vite) and ignore them'; git push } else { Write-Host 'No changes to commit' }"
powershell -ExecutionPolicy Bypass -Command "Remove-Item .git\index.lock -Force -ErrorAction SilentlyContinue; git rm -r --cached frontend/.vite -f -q 2>$null; git rm -r --cached .vite -f -q 2>$null; Remove-Item -Recurse -Force frontend/.vite -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force .vite -ErrorAction SilentlyContinue; if(-not (Test-Path .gitignore)) { '' | Out-File -FilePath .gitignore -Encoding utf8 }; $gitignore=Get-Content .gitignore -Raw; if($gitignore -notmatch '(^|\r?\n)\.vite/') { Add-Content .gitignore '\n.vite/' }; git add .gitignore; git add -A; $s=git status --porcelain; Write-Host $s; if($s -ne '') { git commit -m 'Remove committed .vite artifacts and ignore them'; git push } else { Write-Host 'No changes to commit' }"
powershell -ExecutionPolicy Bypass -Command "Remove-Item .git\index.lock -Force -ErrorAction SilentlyContinue; git rm -r --cached '.vite' -f 2>$null; git rm -r --cached 'frontend/.vite' -f 2>$null; Remove-Item -Recurse -Force '.vite','frontend/.vite' -ErrorAction SilentlyContinue; Add-Content -Path .gitignore -Value '.vite/' ; git add .gitignore; git add -A; if((git status --porcelain) -ne '') { git commit -m 'Remove committed .vite artifacts and ignore them' ; git push } else { Write-Host 'No changes to commit' }"
powershell -ExecutionPolicy Bypass -Command "Remove-Item .git\index.lock -Force -ErrorAction SilentlyContinue; git rm -r --cached .vite -f; git rm -r --cached frontend/.vite -f; git status --porcelain"
powershell -ExecutionPolicy Bypass -Command "Remove-Item .git\index.lock -Force -ErrorAction SilentlyContinue; try { git rm -r --cached .vite -f } catch {}; try { git rm -r --cached frontend/.vite -f } catch {}; Remove-Item -Recurse -Force .vite -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force frontend\.vite -ErrorAction SilentlyContinue; if(-not (Test-Path .gitignore)) { '' | Out-File -FilePath .gitignore -Encoding utf8 }; $g = Get-Content .gitignore -Raw; if($g -notmatch '(^|\r?\n)\.vite/') { Add-Content .gitignore "`n.vite/" }; git add .gitignore; git add -A; $s = (git status --porcelain); Write-Host 'GIT_STATUS:' $s; if($s -ne '') { git commit -m 'Remove committed .vite artifacts and ignore them' ; git push } else { Write-Host 'No changes to commit' }"
powershell -NoProfile -ExecutionPolicy Bypass -Command "git fetch origin; $found = (git ls-tree -r origin/main --name-only | Select-String -Pattern '\.vite'); if(!$found) { git commit --allow-empty -m 'Trigger Railway rebuild: cleanup .vite' ; git push; Write-Host 'NO_VITE_REMOTE' } else { Write-Host 'VITE_FOUND_REMOTE'; $found | ForEach-Object { $p = $_.ToString().Trim(); try { git rm -r --cached --ignore-unmatch -- $p } catch {}; }; git rm -r --cached -- .vite frontend/.vite -f 2>$null; Remove-Item -Recurse -Force .vite -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force frontend\.vite -ErrorAction SilentlyContinue; if(-not (Test-Path .gitignore)) { '' | Out-File -FilePath .gitignore -Encoding utf8 }; $g = Get-Content .gitignore -Raw; if($g -notmatch '(^|\r?\n)\.vite/') { Add-Content .gitignore "`n.vite/" }; git add .gitignore; git add -A; git commit -m 'Remove committed .vite artifacts and ignore them' ; git push; Write-Host 'CLEANUP_PUSHED' }"
powershell -NoProfile -ExecutionPolicy Bypass -Command "git fetch origin; $m = git ls-tree -r origin/main --name-only | Select-String -Pattern '\.vite'; if($m) { $m | ForEach-Object { Write-Host $_.ToString().Trim() } } else { Write-Host 'NO_VITE_REMOTE' }"
powershell -NoProfile -ExecutionPolicy Bypass -Command "git fetch origin; $out = git ls-tree -r origin/main --name-only | Select-String -Pattern '\.vite' -SimpleMatch; if($out) { $out | ForEach-Object { Write-Host ('FOUND: ' + $_.ToString().Trim()) } } else { Write-Host 'NO_VITE_REMOTE' }"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$l = git ls-files | Select-String -Pattern '\.vite'; if($l) { $l | ForEach-Object { Write-Host 'LOCAL:' $_.ToString().Trim() } } else { Write-Host 'NO_LOCAL_VITE' }"
powershell -NoProfile -ExecutionPolicy Bypass -Command "git fetch origin; $c = git rev-parse origin/main; git show --name-only $c | Select-String -Pattern '\.vite' -SimpleMatch | ForEach-Object { Write-Host $_.ToString().Trim() }"
powershell -NoProfile -ExecutionPolicy Bypass -Command "Remove-Item .git\index.lock -Force -ErrorAction SilentlyContinue; git rm -r --cached --ignore-unmatch .vite frontend/.vite; git ls-files --deleted | Select-String -Pattern '\.vite' | ForEach-Object { Write-Host ('REMOVED: ' + $_.ToString().Trim()) }; if(-not (Test-Path .gitignore)) { '' | Out-File .gitignore -Encoding utf8 }; $g = Get-Content .gitignore -Raw; if($g -notmatch '(^|\r?\n)\.vite/') { Add-Content .gitignore "`n.vite/" }; git add .gitignore; git add -A; $s = git status --porcelain; Write-Host 'GIT_STATUS:' $s; if($s -ne '') { git commit -m 'Remove committed .vite artifacts and ignore them'; git push } else { Write-Host 'No changes to commit' }"
powershell -NoProfile -ExecutionPolicy Bypass -Command "Remove-Item .git\index.lock -Force -ErrorAction SilentlyContinue; try { git rm -r --cached '.vite' } catch { }; try { git rm -r --cached 'frontend/.vite' } catch { }; Remove-Item -Recurse -Force '.vite' -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force 'frontend/.vite' -ErrorAction SilentlyContinue; if(-not (Test-Path .gitignore)) { '' | Out-File .gitignore -Encoding utf8 }; $g = Get-Content .gitignore -Raw; if($g -notmatch '(^|\r?\n)\.vite/') { Add-Content .gitignore "`n.vite/" }; git add .gitignore; git add -A; $s = git status --porcelain; Write-Host ('GIT_STATUS:' + $s); if($s -ne '') { git commit -m 'Remove committed .vite artifacts and ignore them'; git push } else { Write-Host 'No changes to commit' }"
powershell -NoProfile -ExecutionPolicy Bypass -Command "git ls-files | Select-String -Pattern '\.vite' | ForEach-Object { Write-Host $_.ToString().Trim() }"
powershell -NoProfile -ExecutionPolicy Bypass -Command "git rm -r --cached .vite"
powershell -NoProfile -ExecutionPolicy Bypass -Command "git rm -r --cached .vite || echo 'git rm .vite failed'; git rm -r --cached frontend/.vite || echo 'git rm frontend/.vite failed'; git status --porcelain; git add .gitignore; git commit -m 'Remove committed .vite artifacts and ignore them' || echo 'commit failed'; git push || echo 'push failed'"
Remove-Item .git\index.lock -Force -ErrorAction SilentlyContinue; 
git fetch origin;
Write-Host '---CHECK REMOTE BEFORE CLEANUP---';
$m = git ls-tree -r origin/main --name-only | Select-String -Pattern '.vite' -SimpleMatch -ErrorAction SilentlyContinue;
if($m) { Write-Host 'VITE_FOUND_REMOTE'; $m | ForEach-Object { Write-Host $_.ToString().Trim() } } else { Write-Host 'NO_VITE_REMOTE' }
try { git rm -r --cached --ignore-unmatch .vite frontend/.vite } catch { Write-Host 'git rm returned non-zero' }
Remove-Item -Recurse -Force .vite -ErrorAction SilentlyContinue;
Remove-Item -Recurse -Force frontend\.vite -ErrorAction SilentlyContinue;

